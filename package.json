{
  "name": "pad",
  "version": "1.0.0",
  "description": "Pine At Dawn",
  "scripts": {
    "test": "npm run test:tutor-gateway",
    "test:tutor-gateway": "node --test scripts/tutor-gateway.test.mjs",
    "tutor-gateway": "node scripts/tutor-gateway.mjs",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev"
  },
  "keywords": [
    "pad",
    "pine at dawn",
    "pineatdawn"
  ],
  "author": "Pine At Dawn",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2"
  }
}
